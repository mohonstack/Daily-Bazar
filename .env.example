# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; this template is committed.

# Base URL of your app (no trailing slash). Used for OAuth callbacks.
BETTER_AUTH_URL=http://localhost:3000

# Secret for signing sessions. Generate one with: npx auth secret
BETTER_AUTH_SECRET=

# MongoDB connection string used by better-auth only (product prices come from
# the external api.api-store.workers.dev API, not from the database).
# The database name is hard-coded as `bazar-dor-project` in src/lib/auth.ts.
MONGODB_CLIENT_URL=

# OAuth providers — callbacks must be registered at:
#   /api/auth/callback/google
#   /api/auth/callback/github
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
